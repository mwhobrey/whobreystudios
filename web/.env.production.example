DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
AUTH_SECRET="<generate-random-32-byte-hex>"
AUTH_URL="https://demo.clientdomain.com"

RESEND_API_KEY="re_..."
EMAIL_FROM="Whobrey Studios <portal@whobrey-studios.llc>"
CRON_SECRET="<random-cron-secret>"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

MAX_UPLOAD_BYTES=52428800

STORAGE_PROVIDER="r2"
STORAGE_BUCKET="whobrey-demo-files"
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="<r2-access-key-id>"
STORAGE_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# Optional seed overrides
# SEED_ADMIN_EMAIL="admin@whobrey.local"
# SEED_ADMIN_PASSWORD="strong-demo-password"
# SEED_CLIENT_EMAIL="client@whobrey.local"
# SEED_CLIENT_EMAILS="client1@example.com,client2@example.com"
# SEED_CLIENT_PASSWORD="strong-demo-password"

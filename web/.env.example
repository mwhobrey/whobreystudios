# Copy to .env. Used by Prisma (prisma.config.ts), Auth.js, and getPrisma().

# Use 127.0.0.1 if `localhost` fails to resolve on your machine (seen on some Windows setups).
DATABASE_URL="postgresql://whobrey:whobrey@127.0.0.1:5432/whobrey_studios"

# Required for Auth.js (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="replace-with-a-long-random-string"

# Production / preview base URL (optional locally)
# AUTH_URL="https://your-domain.example"

# Optional: GitHub OAuth (adds provider alongside credentials)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Local file uploads (draft/final assets). Bytes live under this folder relative to `web/`.
# LOCAL_FILES_DIR=storage/uploads
# Max upload size in bytes (default 52428800 = 50 MB)
# MAX_UPLOAD_BYTES=52428800

# Storage backend (local for dev, r2 for deployed demo)
# STORAGE_PROVIDER=local

# R2 / S3-compatible storage settings (required when STORAGE_PROVIDER=r2)
# STORAGE_BUCKET=whobrey-demo-files
# STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Optional overrides for prisma db seed
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_CLIENT_EMAIL=
# SEED_CLIENT_EMAILS=client1@example.com,client2@example.com
# SEED_CLIENT_PASSWORD=
